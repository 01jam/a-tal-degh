    "@vitejs/plugin-react": "^6.0.5",
    "gh-pages": "^6.3.0",
    "jsdom": "^26.1.0",
    "sass": "^1.102.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "browserslist": {
    "production": [
      ">0.2%",
